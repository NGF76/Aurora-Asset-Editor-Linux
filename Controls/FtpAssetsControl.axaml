<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AuroraAssetEditorLinux.Controls.FtpAssetsControl"
             Background="WhiteSmoke">
    
    <!-- السحب والإفلات في Avalonia يتم التعامل معه في الكود الخلفي -->
    <Grid Margin="10, 10, 10, 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ الصف الأول: الإعدادات ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Expander Grid.Column="0"
                      Header="Settings" IsExpanded="True"
                      BorderBrush="Black">
                <Grid Margin="10, 0, 10, 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- IP Address -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               HorizontalAlignment="Right"
                               Margin="0, 5, 10, 5"
                               Text="IP Address:"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="IpBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Margin="0, 5"
                             VerticalAlignment="Center" />

                    <!-- Port -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               Margin="10, 5, 10, 5"
                               Text="Port:"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="PortBox"
                             Grid.Row="0"
                             Grid.Column="3"
                             HorizontalAlignment="Stretch"
                             Margin="0, 5"
                             Text="21"
                             VerticalAlignment="Center" />

                    <!-- Username -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               HorizontalAlignment="Right"
                               Margin="0, 5, 10, 5"
                               Text="Username:"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="UserBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Margin="0, 5"
                             Text="xboxftp"
                             VerticalAlignment="Center" />

                    <!-- Password -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               Margin="10, 5, 10, 5"
                               Text="Password:"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="PassBox"
                             Grid.Row="1"
                             Grid.Column="3"
                             HorizontalAlignment="Stretch"
                             Margin="0, 5"
                             Text="xboxftp"
                             VerticalAlignment="Center" />

                    <!-- الأزرار -->
                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <Button Content="Test Connection"
                                Margin="0, 5"
                                Padding="10, 5" />
                        <Button Content="Save Settings"
                                Margin="5, 5"
                                Padding="10, 5" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="Bulk DL"
                            Margin="0, 5"
                            Padding="10, 5"
                            HorizontalAlignment="Center" />

                    <Button Grid.Row="2"
                            Grid.Column="3"
                            Content="Get Available Assets"
                            Margin="0, 5"
                            Padding="10, 5"
                            HorizontalAlignment="Right" />
                </Grid>
            </Expander>
        </Grid>

        <!-- ============ الصف الثاني: قائمة الأصول المتاحة ============ -->
        <Expander Grid.Row="1"
                  Header="Available Assets" IsExpanded="True"
                  BorderBrush="Black">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- فلتر العنوان -->
                <Expander Grid.Row="0"
                          Grid.Column="0"
                          Header="Filter on title" IsExpanded="True">
                    <TextBox x:Name="TitleFilterBox" />
                </Expander>

                <!-- فلتر TitleId -->
                <Expander Grid.Row="0"
                          Grid.Column="1"
                          Header="Filter on titleId" IsExpanded="True">
                    <TextBox x:Name="TitleIdFilterBox" />
                </Expander>

                <!-- DataGrid (جدول الأصول) -->
                <DataGrid x:Name="FtpAssetsBox"
                          Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Background="WhiteSmoke"
                          RowBackground="WhiteSmoke"
                          AlternatingRowBackground="LightGray"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          CanUserDeleteRows="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          IsReadOnly="True">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" IsExpanded="True"
                                            Binding="{Binding TitleName}"
                                            Width="*" />
                        <DataGridTextColumn Header="DatabaseID" IsExpanded="True"
                                            Binding="{Binding DatabaseId}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="TitleID" IsExpanded="True"
                                            Binding="{Binding TitleId}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="MediaID" IsExpanded="True"
                                            Binding="{Binding MediaId}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Disc#" IsExpanded="True"
                                            Binding="{Binding DiscNum}"
                                            Width="Auto" />
                    </DataGrid.Columns>

                    <!-- قائمة السياق -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Get All Assets" IsExpanded="True" />
                            <MenuItem Header="Get Boxart" IsExpanded="True" />
                            <MenuItem Header="Get Background" IsExpanded="True" />
                            <MenuItem Header="Get Icon/Banner" IsExpanded="True" />
                            <MenuItem Header="Get Screenshots" IsExpanded="True" />
                            <Separator />
                            <MenuItem Header="Save All Assets" IsExpanded="True" />
                            <MenuItem Header="Save Boxart" IsExpanded="True" />
                            <MenuItem Header="Save Background" IsExpanded="True" />
                            <MenuItem Header="Save Icon/Banner" IsExpanded="True" />
                            <MenuItem Header="Save Screenshots" IsExpanded="True" />
                            <Separator />
                            <MenuItem Header="Remove All Assets" IsExpanded="True" />
                            <MenuItem Header="Remove Boxart" IsExpanded="True" />
                            <MenuItem Header="Remove Background" IsExpanded="True" />
                            <MenuItem Header="Remove Icon/Banner" IsExpanded="True" />
                            <MenuItem Header="Remove Screenshots" IsExpanded="True" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Expander>

        <!-- ============ الصف الثالث: شريط الحالة ============ -->
        <StatusBar Grid.Row="2"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Background="WhiteSmoke">
            <TextBlock x:Name="Status" />
        </StatusBar>
    </Grid>
</UserControl>
