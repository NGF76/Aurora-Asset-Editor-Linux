<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AuroraAssetEditorLinux.TitleAndDbIdDialog"
        Title="Enter Title ID and Database ID"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Width="350"
        MinWidth="300">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ الصف 0: TitleID ============ -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   HorizontalAlignment="Right"
                   Text="TitleID:"
                   Margin="0, 0, 5, 0"
                   VerticalAlignment="Center" />
        
        <TextBox x:Name="TitleIdBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 MinWidth="100"
                 HorizontalAlignment="Stretch"
                 Margin="0, 0, 5, 0"
                 MaxLength="8"
                 Watermark="Enter TitleID (8 hex chars)" />

        <!-- ============ الصف 1: DatabaseID ============ -->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   HorizontalAlignment="Right"
                   Text="DatabaseID:"
                   Margin="0, 10, 5, 0"
                   VerticalAlignment="Center" />
        
        <TextBox x:Name="DbIdBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 MinWidth="100"
                 HorizontalAlignment="Stretch"
                 Margin="0, 10, 5, 0"
                 MaxLength="8"
                 Watermark="Enter DatabaseID (8 hex chars)" />

        <!-- ============ الصف 2: الأزرار ============ -->
        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 15, 0, 0"
                    Spacing="10">
            
            <Button x:Name="OkButton"
                    Content="OK"
                    MinWidth="60"
                    IsEnabled="False" />
            
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="60" />
        </StackPanel>
    </Grid>
</Window>
