<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AuroraAssetEditorLinux.BulkActionsDialog"
        Title="Bulk Download Options"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Width="350"
        MinWidth="300">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ الصف 0: اختيار اللغة ============ -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              x:Name="LocaleGrid"
              MinWidth="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Locale:"
                       Margin="10"
                       VerticalAlignment="Center" />
            
            <ComboBox x:Name="LocaleBox"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="0, 10, 10, 10" />
        </Grid>

        <!-- ============ الصف 1: Replace Existing ============ -->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   HorizontalAlignment="Right"
                   Text="Replace Existing?"
                   Margin="0, 0, 5, 0"
                   VerticalAlignment="Center" />
        
        <CheckBox x:Name="ReplaceExistingChk"
                  Grid.Row="1"
                  Grid.Column="1"
                  MinWidth="10"
                  HorizontalAlignment="Left"
                  Margin="0, 0, 5, 0" />

        <!-- ============ الصف 2: Cover Art Only ============ -->
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   HorizontalAlignment="Right"
                   Text="Cover Art Only?"
                   Margin="0, 0, 5, 0"
                   VerticalAlignment="Center" />
        
        <CheckBox x:Name="CoverArtOnlyChk"
                  Grid.Row="2"
                  Grid.Column="1"
                  MinWidth="10"
                  HorizontalAlignment="Left"
                  Margin="0, 0, 5, 0"
                  IsChecked="True" />

        <!-- ============ الصف 3: الأزرار ============ -->
        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 15, 0, 0"
                    Spacing="10">
            
            <Button x:Name="OkButton"
                    Content="OK"
                    MinWidth="60"
                    HorizontalAlignment="Right" />
            
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="60"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
