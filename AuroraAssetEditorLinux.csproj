<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <RootNamespace>AuroraAssetEditorLinux</RootNamespace>
    <AssemblyName>AuroraAssetEditor</AssemblyName>
    <Title>Aurora Asset Editor Linux</Title>
    <Copyright>Copyright 2015-2023</Copyright>
    <RepositoryUrl>https://github.com/XboxUnity/AuroraAssetEditor</RepositoryUrl>
    <VersionPrefix>v</VersionPrefix>
    <Version>$(VersionPrefix)1.4.3.0</Version>
    <FileVersion>1.4.3.0</FileVersion>
    <PackageVersion>1.4.3.0</PackageVersion>
    <AssemblyVersion>1.4.3.0</AssemblyVersion>
    <InformationalVersion>1.4.0.0</InformationalVersion>
    
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>

    <!-- تضمين جميع ملفات C# في كل المجلدات -->
    

    <!-- حزم Avalonia الأساسية -->
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.0.6" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.1.5.1" />
    
    <!-- ✅ تمت إزالة الحزمة غير الموجودة -->
    <!-- <PackageReference Include="Avalonia.Controls.GroupBox" Version="11.0.10" /> -->
    
    <!-- ✅ إضافة System.Drawing.Common لدعم الصور -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- الموارد (الصور والأيقونات) -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- مكتبات إضافية -->
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- ملفات يجب نسخها عند البناء -->
    <None Update="AuroraAsset.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
