# Spec file options
basepath: .
outdir: .

# Package control file
package: aurora-asset-editor
version: 1.1.0
architecture: amd64
maintainer: NGF76 <your-email@example.com>
homepage: https://github.com/NGF76/Aurora-Asset-Editor-Linux
description: Aurora Asset Editor for Linux.

# Application files
file: publish/** usr/lib/aurora-asset-editor/ 755

# Desktop integration
file: aurora-asset-editor.desktop usr/share/applications/aurora-asset-editor.desktop 644
file: Icons/Aurour.128x128.png usr/share/icons/hicolor/128x128/apps/aurora-asset-editor.png 644
file: Icons/Aurour.256x256.png usr/share/icons/hicolor/256x256/apps/aurora-asset-editor.png 644
file: Icons/Aurour.512x512.png usr/share/icons/hicolor/512x512/apps/aurora-asset-editor.png 644